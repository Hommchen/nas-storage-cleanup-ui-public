{
  "name": "pinas-storage-cleanup-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Safety-first NAS media cleanup console for Jellyfin, qBittorrent and MoviePilot.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hommchen/nas-storage-cleanup-ui-public.git"
  },
  "bugs": {
    "url": "https://github.com/Hommchen/nas-storage-cleanup-ui-public/issues"
  },
  "homepage": "https://github.com/Hommchen/nas-storage-cleanup-ui-public#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 127.0.0.1",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --hostname 127.0.0.1",
    "local": "/opt/homebrew/bin/python3.12 scripts/run-local.py",
    "local:enabled": "/opt/homebrew/bin/python3.12 scripts/run-local.py --enable-execution",
    "local:production": "/opt/homebrew/bin/python3.12 scripts/run-local.py --production",
    "local:production:enabled": "/opt/homebrew/bin/python3.12 scripts/run-local.py --production --enable-execution",
    "test": "npm run lint && npm run test:python && npm run test:plugin && npm run typecheck && npm run build && node --test tests/rendered-html.test.mjs",
    "test:python": "${PINAS_PYTHON:-/opt/homebrew/bin/python3.12} -m unittest discover -s tests -p 'test_*.py' -v",
    "test:plugin": "npm --prefix plugins.v2/storagecleanup ci --no-audit --no-fund && npm --prefix plugins.v2/storagecleanup run check && npm --prefix plugins.v2/storagecleanup run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint app build worker vite.config.ts next.config.ts tests/rendered-html.test.mjs",
    "smoke:readonly": "/opt/homebrew/bin/python3.12 scripts/smoke-readonly.py",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@cloudflare/vite-plugin": "1.48.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "fast-uri": "3.1.4",
    "js-yaml": "4.3.0",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "type": "module"
}
