[Unit]
Description=PiNAS storage cleanup control API
Wants=network-online.target pinas-storage-readiness.service qbittorrent.service
After=network-online.target pinas-storage-readiness.service qbittorrent.service docker.service
RequiresMountsFor=/mnt/sdc /mnt/sdd

[Service]
Type=simple
User=nas-user
Group=nas-user
UMask=0077
WorkingDirectory=/mnt/sdc/library-tools/storage-cleanup-ui/current
Environment=PYTHONUNBUFFERED=1
ExecStartPre=+/usr/local/sbin/pinas-storage-readiness
ExecStart=/usr/bin/python3 scripts/control_server.py --local-nas --host 127.0.0.1 --port 8765 --enable-execution
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
