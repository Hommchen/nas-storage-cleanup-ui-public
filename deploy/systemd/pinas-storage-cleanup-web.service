[Unit]
Description=PiNAS storage cleanup web UI
Wants=network-online.target pinas-storage-readiness.service
After=network-online.target pinas-storage-readiness.service pinas-storage-cleanup-control.service
RequiresMountsFor=@PINAS_BASE@

[Service]
Type=simple
User=@PINAS_USER@
Group=@PINAS_USER@
UMask=0027
WorkingDirectory=@PINAS_BASE@/current
Environment=NODE_ENV=production
Environment=HOME=/home/@PINAS_USER@
ExecStartPre=+/usr/local/sbin/pinas-storage-readiness
ExecStart=/usr/bin/npx --no-install vinext start --hostname 127.0.0.1 --port 3001
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
