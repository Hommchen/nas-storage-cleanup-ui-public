[Unit]
Description=PiNAS storage cleanup LAN gateway
Wants=network-online.target pinas-storage-readiness.service
After=network-online.target pinas-storage-readiness.service pinas-storage-cleanup-control.service pinas-storage-cleanup-web.service
RequiresMountsFor=@PINAS_BASE@

[Service]
Type=simple
User=@PINAS_USER@
Group=@PINAS_USER@
UMask=0027
WorkingDirectory=@PINAS_BASE@/current
Environment=PYTHONUNBUFFERED=1
ExecStartPre=+/usr/local/sbin/pinas-storage-readiness
ExecStart=/usr/bin/python3 scripts/gateway_server.py --host @PINAS_ADDRESS@ --port 3000 --public-origin http://@PINAS_ADDRESS@:3000 --bridge-network 172.17.0.0/16 --bridge-token-file @PINAS_BASE@/shared/runtime/control-token
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
