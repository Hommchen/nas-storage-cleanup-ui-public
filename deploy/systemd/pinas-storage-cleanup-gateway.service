[Unit]
Description=PiNAS storage cleanup LAN gateway
Wants=network-online.target pinas-storage-readiness.service
After=network-online.target pinas-storage-readiness.service pinas-storage-cleanup-control.service pinas-storage-cleanup-web.service
RequiresMountsFor=/srv/storage-cleanup-ui

[Service]
Type=simple
User=nas-user
Group=nas-user
UMask=0027
WorkingDirectory=/srv/storage-cleanup-ui/current
Environment=PYTHONUNBUFFERED=1
ExecStartPre=+/usr/local/sbin/pinas-storage-readiness
ExecStart=/usr/bin/python3 scripts/gateway_server.py --host 127.0.0.1 --port 3000 --bridge-network 172.17.0.0/16 --bridge-token-file /srv/storage-cleanup-ui/shared/runtime/control-token
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
